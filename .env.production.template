# =============================================================================
# CrossWave — Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all secrets.
# NEVER commit .env to version control.
# Rotate all secrets monthly.

# --- LLM / AI API Keys ---
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Volc Engine (Doubao): https://console.volcengine.com/ark
VOLC_ENGINE_API_KEY=ark-your-volc-key
# Fallback generic LLM
LLM_API_KEY=

# --- Payment Processing (Stripe) ---
# From https://dashboard.stripe.com/apikeys — use sk_live key in production
STRIPE_SECRET_KEY=sk_live_your_stripe_key
# From Stripe Dashboard → Webhooks → Add endpoint → signing secret
# Endpoint URL: https://your-domain.com/api/v1/stripe/webhook
# Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- Email / SMTP ---
# Recommended: SendGrid, Mailgun, or any SMTP provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=sg_your_sendgrid_key
SMTP_FROM_EMAIL=hello@crosswave.app
SMTP_FROM_NAME=CrossWave

# --- External Freelance Platforms ---
# Upwork: https://www.upwork.com/developer/keys/apply — OAuth 2.0
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
# 猪八戒: https://open.zbj.com/ — 开放平台注册
ZHUBAJIE_APP_KEY=
ZHUBAJIE_APP_SECRET=

# --- CrossBridge DB Path ---
CROSSBRIDGE_DB=../ai-content-bridge/content_bridge.db

# --- Polsia Fork API Connection ---
# Production: internal Docker network URL or HTTPS
POLSIA_BASE_URL=http://polsia-fork:8000
# WARNING: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POLSIA_API_KEY=changeme-generate-32byte-secret
POLSIA_MOCK=false
PROXY_TIMEOUT=10
DEBUG=false

# --- Public URL (for email links & Stripe redirects) ---
BASE_URL=https://crosswave.app

# --- Production Server Settings ---
HOST=0.0.0.0
PORT=9999
WORKERS=2
