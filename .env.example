# CrossWave — Environment Configuration
# Copy this file to .env and adjust values.

# --- Error Tracking (Sentry) ---
SENTRY_DSN=                               # https://xxx@xxx.ingest.us.sentry.io/xxx

# --- LLM Provider Abstraction (Phase 3) ---
LLM_PROVIDER_MOCK=true                   # true=always mock, false=use real API keys
LLM_API_KEY=                             # OpenAI-compatible API key
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=                        # DeepSeek API key (compatible format)

# --- Payment Processing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CrossWave

# --- External Freelance Platforms ---
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
ZHUBAJIE_APP_KEY=
ZHUBAJIE_APP_SECRET=

# --- CrossBridge ---
CROSSBRIDGE_DB=../ai-content-bridge/content_bridge.db

# --- Polsia Fork API Connection ---
POLSIA_BASE_URL=http://localhost:8000
POLSIA_API_KEY=dev-key
POLSIA_MOCK=true
PROXY_TIMEOUT=5
DEBUG=true

# --- Public URL (for email links) ---
BASE_URL=http://127.0.0.1:9999
